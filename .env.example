# Local development only. Copy this file to .env and replace the password
# before the first startup. Passwords must be at least 8 characters and at
# most 72 UTF-8 bytes.
RAG_ADMIN_USERNAME=admin
RAG_ADMIN_PASSWORD=

# Optional: replace the local MinIO development credentials.
# MINIO_ROOT_USER=ragminio
# MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password

# Enable only behind an HTTPS reverse proxy.
# SESSION_COOKIE_SECURE=true

# Optional: OpenAI-compatible LLM using a local endpoint.
# LLM_ENABLED=true
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=replace-with-local-model-id
# LLM_REVISION=replace-with-pinned-model-revision
# LLM_API_KEY=
# LLM_TIMEOUT=PT15S
# LLM_MAX_OUTPUT_TOKENS=1024
# LLM_CONTEXT_WINDOW_TOKENS=8192
# LLM_LOCAL_ENDPOINT=true
# LLM_REMOTE_EVIDENCE_ALLOWED=false
# LLM_REMOTE_MEMORY_ALLOWED=false

# Optional: GPU embedding and reranking (`docker compose --profile hybrid`).
# EMBEDDING_ENABLED=true
# RERANK_ENABLED=true
# HF_TOKEN=
# INDEXER_EMBEDDING_TIMEOUT=PT30S

# Optional: GraphRAG extraction (`docker compose --profile graph`).
# GRAPH_EXTRACTION_ENABLED=true
# GRAPH_EXTRACTION_BASE_URL=http://host.docker.internal:11434/v1
# GRAPH_EXTRACTION_MODEL=replace-with-local-model-id
# GRAPH_EXTRACTION_REVISION=replace-with-pinned-model-revision
# GRAPH_EXTRACTION_API_KEY=
# GRAPH_EXTRACTION_LOCAL_ENDPOINT=true
# GRAPH_EXTRACTION_REMOTE_EVIDENCE_ALLOWED=false

# Optional: MinerU (`docker compose --profile mineru`).
# MINERU_ENABLED=true
# MINERU_ENDPOINT=http://mineru:8000
# MINERU_LOCAL_ENDPOINT=true
# GPU_ACTIVE_PROFILE=mineru

# Optional: execute real evaluation cases instead of contract-only runs.
# EVALUATION_REAL_ENABLED=true
